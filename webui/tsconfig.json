{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "vue": ["./node_modules/vue/dist/vue.d.ts"],
      "lucide-vue-next": ["./node_modules/lucide-vue-next/dist/lucide-vue-next.d.ts"],
      "@llm-onebot/vue-workbench": ["../packages/vue-workbench/src/index.ts"],
      "@llm-onebot/vue-workbench/runtime": ["../packages/vue-workbench/src/runtime-api.ts"],
      "@llm-onebot/vue-resource-editor": ["../packages/vue-resource-editor/src/index.ts"],
      "@llm-onebot/vue-file-workspace": ["../packages/vue-file-workspace/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "../packages/**/*.ts",
    "../packages/**/*.vue",
    "vite.config.ts"
  ]
}
